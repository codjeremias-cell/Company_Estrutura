    "executiveDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "decision_id",
        "causal",
        "submission_ref",
        "candidate_digest",
        "minimum_score",
        "judge_report_ref",
        "limitation_report_ref",
        "exception_authorization_ref",
        "decision",
        "acceptance_basis",
        "nonwaivable_gates",
        "evidence_refs",
        "decided_at"
      ],
      "properties": {
        "artifact_type": {
          "const": "EXECUTIVE_DECISION"
        },
        "decision_id": {
          "$ref": "#/$defs/identifier"
        },
        "causal": {
          "$ref": "#/$defs/causalHeader"
        },
        "submission_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "judge_report_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "limitation_report_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "exception_authorization_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "enum": [
            "VALIDATED",
            "REWORK",
            "AWAITING_HUMAN_EXCEPTION",
            "VALIDATED_BY_EXCEPTION",
            "BLOCKED",
            "CANCELLED",
            "LIMIT_REACHED"
          ]
        },
        "acceptance_basis": {
          "enum": [
            "quality_gate",
            "jeremias_exception",
            "none"
          ]
        },
        "nonwaivable_gates": {
          "$ref": "#/$defs/nonWaivableGates"
        },
        "evidence_refs": {
          "$ref": "#/$defs/artifactRefs"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "properties": {
            "causal": {
              "properties": {
                "producer": {
                  "const": "ceo-maestro"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "VALIDATED"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "minimum_score": {
                "minimum": 9.5
              },
              "limitation_report_ref": {
                "type": "null"
              },
              "exception_authorization_ref": {
                "type": "null"
              },
              "acceptance_basis": {
                "const": "quality_gate"
              },
              "nonwaivable_gates": {
                "$ref": "#/$defs/nonWaivablePassed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "AWAITING_HUMAN_EXCEPTION"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "minimum_score": {
                "exclusiveMaximum": 9.5
              },
              "limitation_report_ref": {
                "$ref": "#/$defs/artifactRef"
              },
              "exception_authorization_ref": {
                "type": "null"
              },
              "acceptance_basis": {
                "const": "none"
              },
              "nonwaivable_gates": {
                "$ref": "#/$defs/nonWaivablePassed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "VALIDATED_BY_EXCEPTION"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "minimum_score": {
                "exclusiveMaximum": 9.5
              },
              "limitation_report_ref": {
                "$ref": "#/$defs/artifactRef"
              },
              "exception_authorization_ref": {
                "$ref": "#/$defs/artifactRef"
              },
              "acceptance_basis": {
                "const": "jeremias_exception"
              },
              "nonwaivable_gates": {
                "$ref": "#/$defs/nonWaivablePassed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "REWORK",
                  "BLOCKED",
                  "CANCELLED",
                  "LIMIT_REACHED"
                ]
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "acceptance_basis": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
