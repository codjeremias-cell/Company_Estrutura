    "devCapabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "reason",
        "capability",
        "worker_id",
        "expected_contract",
        "discovery_evidence",
        "impact",
        "status",
        "owner"
      ],
      "properties": {
        "artifact_type": {
          "const": "DEV_CAPABILITY_GAP"
        },
        "reason": {
          "enum": [
            "TRACK_SEM_AGENTE",
            "DECISAO_UPSTREAM_AUSENTE",
            "DEPENDENCIA_NOVA",
            "CONFLITO_COM_DECISAO_ACEITA",
            "FORA_DE_ESCOPO"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 10
        },
        "worker_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/workerId"
            },
            {
              "const": "n/a"
            }
          ]
        },
        "expected_contract": {
          "type": "string",
          "minLength": 10
        },
        "discovery_evidence": {
          "type": "string",
          "minLength": 10
        },
        "impact": {
          "type": "string",
          "minLength": 10
        },
        "status": {
          "const": "OPEN"
        },
        "owner": {
          "const": "diretor-de-lentes"
        }
      }
    },
    "devLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "dev_ledger_id",
        "causal",
        "department_mission_ref",
        "track",
        "plan",
        "assignments",
        "returns_seen",
        "edges",
        "test_evidence",
        "candidate_digest",
        "assumptions",
        "ponytails",
        "delegated_dependencies",
        "capability_gaps",
        "evidence_refs",
        "pending",
        "entrega",
        "return_to",
        "recorded_at"
      ],
      "properties": {
        "artifact_type": {
          "const": "DEV_LEDGER"
        },
        "dev_ledger_id": {
          "$ref": "#/$defs/identifier"
        },
        "causal": {
          "$ref": "#/$defs/causalHeader"
        },
        "department_mission_ref": {
          "$ref": "#/$defs/identifier"
        },
        "track": {
          "$ref": "#/$defs/track"
        },
        "plan": {
          "$ref": "#/$defs/devPlan"
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignmentRecord"
          },
          "uniqueItems": true
        },
        "returns_seen": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edgeCoverage"
          },
          "uniqueItems": true
        },
        "test_evidence": {
          "$ref": "#/$defs/testEvidence"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "reviewed": {
          "type": "boolean"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionItem"
          },
          "uniqueItems": true
        },
        "ponytails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ponytailItem"
          },
          "uniqueItems": true
        },
        "delegated_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delegatedDependency"
          },
          "uniqueItems": true
        },
        "capability_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/devCapabilityGap"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "$ref": "#/$defs/requiredRefs"
        },
        "pending": {
          "$ref": "#/$defs/optionalStrings"
        },
        "entrega": {
          "enum": [
            "ENTREGUE",
            "INCOMPLETA",
            "BLOQUEADA"
          ]
        },
        "return_to": {
          "const": "diretor-de-lentes"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "comment": "G6 e G7: bordas cobertas, bateria sem FAIL, revisao feita e emissao registrada.",
          "if": {
            "properties": {
              "entrega": {
                "const": "ENTREGUE"
              }
            },
            "required": [
              "entrega"
            ]
          },
          "then": {
            "required": [
              "reviewed"
            ],
            "properties": {
              "edges": {
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "vazio": {
                      "const": true
                    },
                    "limite": {
                      "const": true
                    },
                    "erro": {
                      "const": true
                    }
                  }
                }
              },
              "test_evidence": {
                "properties": {
                  "fail": {
                    "const": 0
                  }
                }
              },
              "reviewed": {
                "const": true
              },
              "assignments": {
                "minItems": 1
              },
              "capability_gaps": {
                "maxItems": 0
              },
              "pending": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "comment": "Lacuna aberta fecha o ramo.",
          "if": {
            "properties": {
              "capability_gaps": {
                "minItems": 1
              }
            },
            "required": [
              "capability_gaps"
            ]
          },
          "then": {
            "properties": {
              "entrega": {
                "const": "BLOQUEADA"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/devPlan"
    },
    {
      "$ref": "#/$defs/devTask"
    },
    {
      "$ref": "#/$defs/devReturn"
    },
