        "dissent_refs": { "$ref": "#/$defs/idList" },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "quality_state": {
          "enum": ["PROVED", "FAILED", "PARTIAL", "BLOCKED"]
        },
        "recommendation": {
          "enum": [
            "READY_FOR_JUDGMENT",
            "REWORK_REQUIRED",
            "NOT_PROVEN",
            "BLOCKED"
          ]
        },
        "judge_required": { "const": true },
        "returned_to": { "const": "diretor-de-lentes" },
        "returned_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "properties": {
            "causal": {
              "properties": {
                "producer": { "const": "departamento-qa-usabilidade" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": { "const": "READY_FOR_JUDGMENT" }
            },
            "required": ["recommendation"]
          },
          "then": {
            "properties": {
              "mode": { "const": "ATUA" },
              "quality_state": { "const": "PROVED" },
              "assignment_refs": { "$ref": "#/$defs/requiredIdList" },
              "agent_return_refs": { "$ref": "#/$defs/requiredIdList" },
              "evidence_refs": { "$ref": "#/$defs/requiredIdList" },
              "defect_refs": { "maxItems": 0 },
              "pending": { "maxItems": 0 },
              "confidence": { "const": "HIGH" },
              "test_summary": {
                "properties": {
                  "pass": { "type": "integer", "minimum": 1 },
                  "fail": { "const": 0 },
                  "skip": { "const": 0 },
                  "skip_reasons": { "maxItems": 0 },
                  "critical_fail": { "const": false }
                }
              },
              "coverage_summary": {
                "properties": {
                  "applicable": { "type": "integer", "minimum": 1 },
                  "evaluated": { "type": "integer", "minimum": 1 },
                  "passed": { "type": "integer", "minimum": 1 },
                  "failed": { "const": 0 },
                  "skipped": { "const": 0 },
                  "unverified": { "const": 0 },
                  "missing": { "const": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": { "const": "REWORK_REQUIRED" }
            },
            "required": ["recommendation"]
          },
          "then": {
            "properties": {
              "quality_state": { "const": "FAILED" },
              "assignment_refs": { "$ref": "#/$defs/requiredIdList" },
              "agent_return_refs": { "$ref": "#/$defs/requiredIdList" },
              "evidence_refs": { "$ref": "#/$defs/requiredIdList" },
              "pending": { "minItems": 1 },
              "test_summary": {
                "properties": {
                  "fail": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": { "const": "NOT_PROVEN" }
            },
            "required": ["recommendation"]
          },
          "then": {
            "properties": {
              "quality_state": { "const": "PARTIAL" },
              "assignment_refs": { "$ref": "#/$defs/requiredIdList" },
              "agent_return_refs": { "$ref": "#/$defs/requiredIdList" },
              "pending": { "minItems": 1 },
              "test_summary": {
                "properties": {
                  "fail": { "const": 0 },
                  "critical_fail": { "const": false }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recommendation": { "const": "BLOCKED" }
            },
            "required": ["recommendation"]
          },
          "then": {
            "properties": {
              "quality_state": { "const": "BLOCKED" },
              "pending": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
