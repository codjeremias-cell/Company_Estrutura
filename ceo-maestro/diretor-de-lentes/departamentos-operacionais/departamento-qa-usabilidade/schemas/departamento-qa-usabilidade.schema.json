        "department_mission_ref": { "$ref": "#/$defs/identifier" },
        "plan_ref": { "$ref": "#/$defs/identifier" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "mode": { "enum": ["ATUA", "CONSULTA"] },
        "assignment_refs": { "$ref": "#/$defs/idList" },
        "agent_return_refs": { "$ref": "#/$defs/idList" },
        "coverage_summary": { "$ref": "#/$defs/coverageSummary" },
