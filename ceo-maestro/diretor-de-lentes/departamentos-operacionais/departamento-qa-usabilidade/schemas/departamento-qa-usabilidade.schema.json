{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-crowd.local/schemas/departamento-qa-usabilidade.schema.json",
  "title": "Artefatos internos do Departamento de QA e Usabilidade",
  "oneOf": [
    { "$ref": "#/$defs/qaTestPlan" },
    { "$ref": "#/$defs/qaAssignment" },
    { "$ref": "#/$defs/qaAgentReturn" },
    { "$ref": "#/$defs/qaRouteRejection" },
    { "$ref": "#/$defs/qaCapabilityGap" },
    { "$ref": "#/$defs/qaConsolidatedReport" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNAText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*[Nn]/[Aa]\\s*$)\\S(?:.*\\S)?$"
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "requiredStringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredOperationalList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonNAText" },
      "minItems": 1,
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "requiredIdList": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "edgeDimension": {
      "enum": [
        "happy-path",
        "validation",
        "permissions",
        "state",
        "scale",
        "failure",
        "data",
        "ux",
        "recovery",
        "concurrency",
        "security",
        "integration"
      ]
    },
    "coveredEdgeDimensionList": {
      "type": "array",
      "items": { "$ref": "#/$defs/edgeDimension" },
      "minItems": 1,
      "uniqueItems": true
    },
    "notApplicableEdgeDimensionList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:happy-path|validation|permissions|state|scale|failure|data|ux|recovery|concurrency|security|integration):.{3,}$"
      },
      "uniqueItems": true
    },
    "operationalOwner": {
      "enum": [
        "departamento-qa-usabilidade",
        "agente-testes-funcionais",
        "agente-testes-nao-funcionais",
        "agente-usabilidade-e-acessibilidade",
        "diretor-de-lentes",
        "environment-owner",
        "artifact-owner"
      ]
    },
    "operationalNextStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "reason_refs"],
      "properties": {
        "action": {
          "enum": [
            "CONSOLIDATE",
            "RETEST",
            "REQUEST_MISSING_EVIDENCE",
            "RESTORE_CAPABILITY",
            "RETURN_FOR_REWORK",
            "ESCALATE_TO_MANAGER"
          ]
        },
        "owner": { "$ref": "#/$defs/operationalOwner" },
        "reason_refs": { "$ref": "#/$defs/requiredIdList" }
      }
    },
    "agentId": {
      "enum": [
        "agente-testes-funcionais",
        "agente-testes-nao-funcionais",
        "agente-usabilidade-e-acessibilidade"
      ]
    },
    "producerId": {
      "enum": [
        "departamento-qa-usabilidade",
        "agente-testes-funcionais",
        "agente-testes-nao-funcionais",
        "agente-usabilidade-e-acessibilidade"
      ]
    },
    "capability": {
      "enum": [
        "FUNCTIONAL",
        "NON_FUNCTIONAL",
        "USABILITY_A11Y"
      ]
    },
    "profile": {
      "enum": [
        "DESKTOP",
        "WEB_MOBILE",
        "API_CLI",
        "DATA_DATABASE",
        "DASHBOARD_VISUALIZATION",
        "REPORT_DOCUMENT_PDF",
        "GAME"
      ]
    },
    "profileList": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" },
      "minItems": 1,
      "uniqueItems": true
    },
    "causalHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "department_mission_id",
        "handoff_id",
        "message_id",
        "causation_message_ids",
        "contract_id",
        "contract_version",
        "contract_digest",
        "candidate_digest",
        "round",
        "attempt",
        "producer",
        "producer_version",
        "producer_digest",
        "created_at"
      ],
      "properties": {
        "work_item_id": { "$ref": "#/$defs/identifier" },
        "department_mission_id": { "$ref": "#/$defs/identifier" },
        "handoff_id": { "$ref": "#/$defs/identifier" },
        "message_id": { "$ref": "#/$defs/identifier" },
        "causation_message_ids": { "$ref": "#/$defs/requiredIdList" },
        "contract_id": { "$ref": "#/$defs/identifier" },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "producer": { "$ref": "#/$defs/producerId" },
        "producer_version": { "$ref": "#/$defs/nonEmptyString" },
        "producer_digest": { "$ref": "#/$defs/digest" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_policy",
        "allowed_tools",
        "allowed_resources",
        "expires_at"
      ],
      "properties": {
        "default_policy": { "const": "deny" },
        "allowed_tools": { "$ref": "#/$defs/stringList" },
        "allowed_resources": { "$ref": "#/$defs/stringList" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_testing_allowed",
        "authorization_ref",
        "authorized_by",
        "issued_at",
        "expires_at",
        "status",
        "targets",
        "environments",
        "window",
        "allowed_tools",
        "allowed_actions",
        "prohibited_actions",
        "rate_volume_concurrency_limits",
        "data_classes_allowed",
        "test_accounts",
        "evidence_handling",
        "cleanup_plan_ref",
        "recovery_plan_ref",
        "stop_conditions",
        "emergency_contact",
        "recheck_interval"
      ],
      "properties": {
        "active_testing_allowed": { "type": "boolean" },
        "authorization_ref": { "$ref": "#/$defs/nonEmptyString" },
        "authorized_by": { "$ref": "#/$defs/nonEmptyString" },
        "issued_at": { "$ref": "#/$defs/nonEmptyString" },
        "expires_at": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "enum": [
            "active",
            "revoked",
            "expired",
            "not_required"
          ]
        },
        "targets": { "$ref": "#/$defs/stringList" },
        "environments": { "$ref": "#/$defs/stringList" },
        "window": { "$ref": "#/$defs/nonEmptyString" },
        "allowed_tools": { "$ref": "#/$defs/stringList" },
        "allowed_actions": { "$ref": "#/$defs/stringList" },
        "prohibited_actions": { "$ref": "#/$defs/stringList" },
        "rate_volume_concurrency_limits": { "$ref": "#/$defs/stringList" },
        "data_classes_allowed": { "$ref": "#/$defs/stringList" },
        "test_accounts": { "$ref": "#/$defs/stringList" },
        "evidence_handling": { "$ref": "#/$defs/stringList" },
        "cleanup_plan_ref": { "$ref": "#/$defs/nonEmptyString" },
        "recovery_plan_ref": { "$ref": "#/$defs/nonEmptyString" },
        "stop_conditions": { "$ref": "#/$defs/stringList" },
        "emergency_contact": { "$ref": "#/$defs/nonEmptyString" },
        "recheck_interval": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active_testing_allowed": { "const": true }
            },
            "required": ["active_testing_allowed"]
          },
          "then": {
            "properties": {
              "status": { "const": "active" },
              "authorization_ref": { "$ref": "#/$defs/nonNAText" },
              "authorized_by": { "$ref": "#/$defs/nonNAText" },
              "issued_at": { "$ref": "#/$defs/timestamp" },
              "expires_at": { "$ref": "#/$defs/timestamp" },
              "targets": { "$ref": "#/$defs/requiredOperationalList" },
              "environments": { "$ref": "#/$defs/requiredOperationalList" },
              "window": { "$ref": "#/$defs/nonNAText" },
              "allowed_tools": { "$ref": "#/$defs/requiredOperationalList" },
              "allowed_actions": { "$ref": "#/$defs/requiredOperationalList" },
              "prohibited_actions": {
                "$ref": "#/$defs/requiredOperationalList"
              },
              "rate_volume_concurrency_limits": {
                "$ref": "#/$defs/requiredOperationalList"
              },
              "data_classes_allowed": {
                "$ref": "#/$defs/requiredOperationalList"
              },
              "test_accounts": { "$ref": "#/$defs/requiredOperationalList" },
              "evidence_handling": {
                "$ref": "#/$defs/requiredOperationalList"
              },
              "cleanup_plan_ref": { "$ref": "#/$defs/nonNAText" },
              "recovery_plan_ref": { "$ref": "#/$defs/nonNAText" },
              "stop_conditions": { "$ref": "#/$defs/requiredOperationalList" },
              "emergency_contact": { "$ref": "#/$defs/nonNAText" },
              "recheck_interval": { "$ref": "#/$defs/nonNAText" }
            }
          }
        }
      ]
    },
    "pendingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_id",
        "obligation",
        "owner",
        "impact",
        "resume_when",
        "causal_ref",
        "blocking"
      ],
      "properties": {
        "pending_id": { "$ref": "#/$defs/identifier" },
        "obligation": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "resume_when": { "$ref": "#/$defs/nonEmptyString" },
        "causal_ref": { "$ref": "#/$defs/identifier" },
        "blocking": { "type": "boolean" }
      }
    },
    "pendingList": {
      "type": "array",
      "items": { "$ref": "#/$defs/pendingItem" },
      "uniqueItems": true
    },
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "failure",
        "impact",
        "severity",
        "criterion_ids"
      ],
      "properties": {
        "risk_id": { "$ref": "#/$defs/identifier" },
        "failure": { "$ref": "#/$defs/nonEmptyString" },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "criterion_ids": { "$ref": "#/$defs/requiredIdList" }
      }
    },
    "criterionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "observable",
        "priority",
        "profiles",
        "risk_ids",
        "applicable",
        "owner_agent",
        "method",
        "evidence_required",
        "not_applicable_reason"
      ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "observable": { "$ref": "#/$defs/nonEmptyString" },
        "priority": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "profiles": { "$ref": "#/$defs/profileList" },
        "risk_ids": { "$ref": "#/$defs/requiredIdList" },
        "applicable": { "type": "boolean" },
        "owner_agent": {
          "oneOf": [
            { "$ref": "#/$defs/agentId" },
            { "type": "null" }
          ]
        },
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_required": { "$ref": "#/$defs/requiredStringList" },
        "not_applicable_reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicable": { "const": true }
            },
            "required": ["applicable"]
          },
          "then": {
            "properties": {
              "owner_agent": { "$ref": "#/$defs/agentId" },
              "not_applicable_reason": { "const": "n/a" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicable": { "const": false }
            },
            "required": ["applicable"]
          },
          "then": {
            "properties": {
              "owner_agent": { "type": "null" },
              "not_applicable_reason": {
                "$ref": "#/$defs/nonNAText"
              }
            }
          }
        }
      ]
    },
    "skipDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "impact",
        "owner",
        "resume_when"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "resume_when": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "criterion_id",
        "profile",
        "status",
        "severity",
        "expected",
        "observed",
        "method",
        "environment",
        "executed_at",
        "evidence_refs",
        "skip_detail"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "profile": { "$ref": "#/$defs/profile" },
        "status": {
          "enum": ["PASS", "FAIL", "SKIP", "UNVERIFIED"]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "none"]
        },
        "expected": { "$ref": "#/$defs/nonEmptyString" },
        "observed": { "$ref": "#/$defs/nonEmptyString" },
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "executed_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "evidence_refs": { "$ref": "#/$defs/idList" },
        "skip_detail": {
          "oneOf": [
            { "$ref": "#/$defs/skipDetail" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["PASS", "FAIL"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "executed_at": { "$ref": "#/$defs/timestamp" },
              "evidence_refs": { "$ref": "#/$defs/requiredIdList" },
              "skip_detail": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "FAIL" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "severity": {
                "enum": ["critical", "high", "medium", "low"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "SKIP" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "executed_at": { "type": "null" },
              "skip_detail": { "$ref": "#/$defs/skipDetail" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "UNVERIFIED" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "skip_detail": { "type": "null" }
            }
          }
        }
      ]
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "case_id",
        "criterion_id",
        "type",
        "origin",
        "tool_and_version",
        "target_ref",
        "candidate_digest",
        "environment",
        "collected_at",
        "collected_by",
        "raw_output_ref",
        "integrity_check",
        "redaction",
        "limits"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "case_id": { "$ref": "#/$defs/identifier" },
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "source",
            "test_output",
            "log",
            "measurement",
            "query_result",
            "accessibility_report",
            "usability_session",
            "screenshot",
            "video",
            "document",
            "attestation"
          ]
        },
        "origin": { "$ref": "#/$defs/nonEmptyString" },
        "tool_and_version": { "$ref": "#/$defs/nonEmptyString" },
        "target_ref": { "$ref": "#/$defs/nonEmptyString" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "collected_at": { "$ref": "#/$defs/timestamp" },
        "collected_by": { "$ref": "#/$defs/agentId" },
        "raw_output_ref": { "$ref": "#/$defs/nonEmptyString" },
        "integrity_check": { "$ref": "#/$defs/nonEmptyString" },
        "redaction": { "$ref": "#/$defs/nonEmptyString" },
        "limits": { "$ref": "#/$defs/stringList" }
      }
    },
    "defectItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_id",
        "risk_ids",
        "case_id",
        "evidence_refs",
        "candidate_digest",
        "environment",
        "severity",
        "title",
        "preconditions",
        "reproduction_steps",
        "expected",
        "observed",
        "impact",
        "reproducibility",
        "status",
        "owner",
        "retest_evidence_ref"
      ],
      "properties": {
        "defect_id": { "$ref": "#/$defs/identifier" },
        "risk_ids": { "$ref": "#/$defs/requiredIdList" },
        "case_id": { "$ref": "#/$defs/identifier" },
        "evidence_refs": { "$ref": "#/$defs/requiredIdList" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "preconditions": { "$ref": "#/$defs/requiredStringList" },
        "reproduction_steps": { "$ref": "#/$defs/requiredStringList" },
        "expected": { "$ref": "#/$defs/nonEmptyString" },
        "observed": { "$ref": "#/$defs/nonEmptyString" },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "reproducibility": {
          "enum": ["always", "intermittent", "once", "unknown"]
        },
        "status": {
          "enum": [
            "open",
            "fixed_unverified",
            "retest_passed"
          ]
        },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "retest_evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "authorizationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "status_seen",
        "decision",
        "policy_digest",
        "evidence_ref",
        "revocation_ref"
      ],
      "properties": {
        "checked_at": { "$ref": "#/$defs/timestamp" },
        "status_seen": {
          "enum": ["active", "revoked", "expired", "not_required"]
        },
        "decision": {
          "enum": ["allowed", "denied", "interrupted", "not_required"]
        },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
        "revocation_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cleaned_by",
        "cleaned_at",
        "scope_cleaned",
        "residuals",
        "evidence_refs",
        "recovery_status",
        "recovery_evidence_refs",
        "pending_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PROVED",
            "PARTIAL",
            "FAILED",
            "NOT_APPLICABLE",
            "UNVERIFIED"
          ]
        },
        "cleaned_by": { "$ref": "#/$defs/nonEmptyString" },
        "cleaned_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "const": "n/a" }
          ]
        },
        "scope_cleaned": { "$ref": "#/$defs/stringList" },
        "residuals": { "$ref": "#/$defs/stringList" },
        "evidence_refs": { "$ref": "#/$defs/idList" },
        "recovery_status": {
          "enum": [
            "PROVED",
            "PARTIAL",
            "FAILED",
            "NOT_APPLICABLE",
            "UNVERIFIED"
          ]
        },
        "recovery_evidence_refs": { "$ref": "#/$defs/idList" },
        "pending_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "PROVED" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "cleaned_at": { "$ref": "#/$defs/timestamp" },
              "scope_cleaned": { "$ref": "#/$defs/requiredStringList" },
              "evidence_refs": { "$ref": "#/$defs/requiredIdList" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PARTIAL",
                  "FAILED",
                  "NOT_APPLICABLE",
                  "UNVERIFIED"
                ]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "pending_ref": {
                "$ref": "#/$defs/nonNAText"
              }
            }
          }
        }
      ]
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "evaluated",
        "passed",
        "failed",
        "skipped",
        "unverified",
        "missing"
      ],
      "properties": {
        "applicable": { "type": "integer", "minimum": 0 },
        "evaluated": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
