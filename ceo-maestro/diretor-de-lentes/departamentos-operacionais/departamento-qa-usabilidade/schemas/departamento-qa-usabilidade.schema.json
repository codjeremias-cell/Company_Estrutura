        "scope_in": { "$ref": "#/$defs/requiredStringList" },
        "scope_out": { "$ref": "#/$defs/stringList" },
        "target_ref": { "$ref": "#/$defs/nonEmptyString" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "inputs": { "$ref": "#/$defs/requiredStringList" },
        "deliverables": { "$ref": "#/$defs/requiredStringList" },
        "done": { "$ref": "#/$defs/requiredStringList" },
        "required_evidence": { "$ref": "#/$defs/requiredStringList" },
        "depends_on": { "$ref": "#/$defs/idList" },
        "permissions": { "$ref": "#/$defs/permissions" },
        "execution_policy": { "$ref": "#/$defs/executionPolicy" },
        "test_data": { "$ref": "#/$defs/stringList" },
        "stop_when": { "$ref": "#/$defs/requiredStringList" },
        "return_to": { "const": "departamento-qa-usabilidade" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "properties": {
            "causal": {
              "properties": {
                "producer": { "const": "departamento-qa-usabilidade" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient": { "const": "agente-testes-funcionais" }
            },
            "required": ["recipient"]
          },
          "then": {
            "properties": {
              "capability": { "const": "FUNCTIONAL" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient": { "const": "agente-testes-nao-funcionais" }
            },
            "required": ["recipient"]
          },
          "then": {
            "properties": {
              "capability": { "const": "NON_FUNCTIONAL" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient": { "const": "agente-usabilidade-e-acessibilidade" }
            },
            "required": ["recipient"]
          },
          "then": {
            "properties": {
              "capability": { "const": "USABILITY_A11Y" }
            }
          }
        }
      ]
    },
    "qaAgentReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "agent_return_id",
        "causal",
        "department_mission_ref",
