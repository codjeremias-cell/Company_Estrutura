        "results",
        "evidence",
        "defects",
        "pending",
        "dissent_refs",
        "authorization_check",
        "cleanup",
        "recommended_next_step",
        "returned_to",
        "returned_at"
      ],
      "properties": {
        "artifact_type": { "const": "QA_AGENT_RETURN" },
        "agent_return_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "department_mission_ref": { "$ref": "#/$defs/identifier" },
        "plan_ref": { "$ref": "#/$defs/identifier" },
        "assignment_ref": { "$ref": "#/$defs/identifier" },
        "assignment_digest": { "$ref": "#/$defs/digest" },
        "execution_policy_digest": { "$ref": "#/$defs/digest" },
        "agent_id": { "$ref": "#/$defs/agentId" },
        "capability": { "$ref": "#/$defs/capability" },
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "blocked"
          ]
        },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "profiles": { "$ref": "#/$defs/profileList" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/testResult" },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" },
          "uniqueItems": true
        },
        "defects": {
          "type": "array",
          "items": { "$ref": "#/$defs/defectItem" },
          "uniqueItems": true
        },
        "pending": { "$ref": "#/$defs/pendingList" },
        "dissent_refs": { "$ref": "#/$defs/idList" },
        "authorization_check": { "$ref": "#/$defs/authorizationCheck" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "recommended_next_step": {
          "$ref": "#/$defs/operationalNextStep"
        },
        "returned_to": { "const": "departamento-qa-usabilidade" },
        "returned_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "agent_id": { "const": "agente-testes-funcionais" }
            },
            "required": ["agent_id"]
          },
          "then": {
            "properties": {
              "capability": { "const": "FUNCTIONAL" },
              "causal": {
                "properties": {
                  "producer": { "const": "agente-testes-funcionais" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "agent_id": { "const": "agente-testes-nao-funcionais" }
            },
            "required": ["agent_id"]
          },
          "then": {
            "properties": {
              "capability": { "const": "NON_FUNCTIONAL" },
              "causal": {
                "properties": {
                  "producer": { "const": "agente-testes-nao-funcionais" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "agent_id": { "const": "agente-usabilidade-e-acessibilidade" }
            },
            "required": ["agent_id"]
          },
          "then": {
            "properties": {
              "capability": { "const": "USABILITY_A11Y" },
              "causal": {
                "properties": {
                  "producer": { "const": "agente-usabilidade-e-acessibilidade" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "results": {
                "contains": {
                  "properties": {
                    "status": { "const": "FAIL" }
                  },
                  "required": ["status"]
                }
              }
            },
            "required": ["results"]
          },
          "then": {
            "properties": {
              "defects": { "minItems": 1 },
              "pending": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "results": {
                "contains": {
                  "properties": {
                    "status": {
                      "enum": ["SKIP", "UNVERIFIED"]
                    }
                  },
                  "required": ["status"]
                }
              }
            },
            "required": ["results"]
          },
          "then": {
            "properties": {
              "status": { "enum": ["partial", "blocked"] }
            }
          }
        }
      ]
    },
