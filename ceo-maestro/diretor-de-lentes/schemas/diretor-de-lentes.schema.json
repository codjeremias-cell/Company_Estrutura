            "causal": {
              "properties": {
                "producer": { "const": "diretor-de-lentes" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_type": { "const": "BLOCKED_RETURN" }
            },
            "required": ["artifact_type"]
          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "D_BLOCKED",
                  "D_LIMIT_REACHED_RETURNED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
