          },
          "then": {
            "properties": {
              "state": {
                "enum": [
                  "D_CONTRACT_VERIFIED",
                  "D_CAPABILITIES_VERIFIED",
                  "D_PLANNED",
                  "D_DELEGATED",
                  "D_INTEGRATING",
                  "D_AWAITING_JUDGES",
                  "D_REWORK",
