    "directorReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "director_return_id",
        "causal",
        "executive_mission_ref",
        "state",
        "summary",
        "artifact_refs",
        "evidence_refs",
        "director_gap_refs",
        "blocking_pending_refs",
        "next_event",
        "returned_to",
        "returned_at"
      ],
      "properties": {
        "artifact_type": {
          "enum": [
            "BLOCKED_RETURN",
