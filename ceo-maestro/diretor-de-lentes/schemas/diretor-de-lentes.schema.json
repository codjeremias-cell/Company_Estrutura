          ]
        },
        "director_return_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "executive_mission_ref": { "$ref": "#/$defs/identifier" },
        "state": { "$ref": "#/$defs/directorState" },
        "summary": {
          "type": "string",
          "minLength": 3
        },
        "artifact_refs": { "$ref": "#/$defs/optionalRefs" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefs" },
        "director_gap_refs": { "$ref": "#/$defs/optionalRefs" },
