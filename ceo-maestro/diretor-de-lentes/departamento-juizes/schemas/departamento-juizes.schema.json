{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-crowd.local/schemas/departamento-juizes.schema.json",
  "title": "Contratos internos do Departamento de Juízes",
  "description": "Repartição de critérios, atribuição aos agentes, parecer por ótica, consolidação pela menor nota, lacuna de cobertura e handoff do modo DISPUTA. Os envelopes de fronteira (JUDGMENT_REQUEST, DEPARTMENT_JUDGE_REPORT, JUDGE_REPORT) pertencem aos schemas do diretor-de-lentes e do ceo-maestro e não são redefinidos aqui.",
  "oneOf": [
    { "$ref": "#/$defs/criteriaMatrix" },
    { "$ref": "#/$defs/judgeAssignment" },
    { "$ref": "#/$defs/judgeOpinion" },
    { "$ref": "#/$defs/judgeCapabilityGap" },
    { "$ref": "#/$defs/panelRecord" },
    { "$ref": "#/$defs/panelHandoff" },
    { "$ref": "#/$defs/independentVerificationRecord" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "requiredRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRef" },
      "minItems": 1,
      "uniqueItems": true
    },
    "optionalRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactRef" },
      "uniqueItems": true
    },
    "requiredStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "minItems": 1,
      "uniqueItems": true
    },
    "optionalStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "lens": {
      "enum": [
        "fidelidade-e-contrato",
        "robustez-e-evidencia",
        "experiencia-e-risco"
      ]
    },
    "judgeId": {
      "enum": [
        "agente-julgar-fidelidade-e-contrato",
        "agente-julgar-robustez-e-evidencia",
        "agente-julgar-experiencia-e-risco"
      ]
    },
    "mode": {
      "enum": [ "VALIDACAO", "DISPUTA", "VERIFICACAO" ]
    },
    "score": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 10 },
        { "type": "string", "pattern": "^n/a:.{5,}$" }
      ]
    },
    "banda": {
      "enum": [ "quebrado", "cru", "polido", "excelente", "n/a" ]
    },
    "judgeStatus": {
      "enum": [ "COMPLETED", "BLOCKED", "SEM_RETORNO", "FALHO" ]
    },
    "confidence": {
      "enum": [ "alta", "media", "baixa", "n/a" ]
    },
    "causalHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_item_id",
        "front_id",
        "handoff_id",
        "message_id",
        "causation_message_ids",
        "contract_id",
        "contract_version",
        "contract_digest",
        "candidate_digest",
        "round",
        "attempt",
        "producer",
        "producer_version",
        "producer_digest",
        "created_at"
      ],
      "properties": {
        "work_item_id": { "$ref": "#/$defs/identifier" },
        "front_id": { "$ref": "#/$defs/identifier" },
        "handoff_id": { "$ref": "#/$defs/identifier" },
        "message_id": { "$ref": "#/$defs/identifier" },
        "causation_message_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "contract_id": { "$ref": "#/$defs/identifier" },
        "contract_version": { "type": "integer", "minimum": 1 },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "round": { "type": "integer", "minimum": 1, "maximum": 10 },
        "attempt": { "type": "integer", "minimum": 1 },
        "producer": { "const": "departamento-juizes" },
        "producer_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "producer_digest": { "$ref": "#/$defs/digest" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "contractExcerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "done",
        "scope_in",
        "scope_out",
        "constraints",
        "decisions",
        "not_applicable"
      ],
      "properties": {
        "intent": { "type": "string", "minLength": 3 },
        "done": { "$ref": "#/$defs/optionalStrings" },
        "scope_in": { "$ref": "#/$defs/optionalStrings" },
        "scope_out": { "$ref": "#/$defs/optionalStrings" },
        "constraints": { "$ref": "#/$defs/optionalStrings" },
        "decisions": { "$ref": "#/$defs/optionalStrings" },
        "not_applicable": { "$ref": "#/$defs/optionalStrings" }
      }
    },
    "matrixItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "criterion_text",
        "owner_lens",
        "owner_reason",
        "secondary_lens"
      ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "criterion_text": { "type": "string", "minLength": 10 },
        "owner_lens": { "$ref": "#/$defs/lens" },
        "owner_reason": { "type": "string", "minLength": 10 },
        "secondary_lens": {
          "oneOf": [
            { "$ref": "#/$defs/lens" },
            { "const": "n/a" }
          ]
        }
      }
    },
    "criteriaMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "criteria_matrix_id",
        "causal",
        "judgment_request_ref",
        "mode",
        "items",
        "uncovered",
        "created_at"
      ],
      "properties": {
        "artifact_type": { "const": "CRITERIA_MATRIX" },
        "criteria_matrix_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "judgment_request_ref": { "$ref": "#/$defs/identifier" },
        "mode": { "$ref": "#/$defs/mode" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/matrixItem" },
          "minItems": 1,
          "uniqueItems": true
        },
        "uncovered": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "assignmentCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "criterion_id", "criterion_text", "role" ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "criterion_text": { "type": "string", "minLength": 10 },
        "role": { "enum": [ "owner", "secondary" ] }
      }
    },
    "judgeAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "assignment_id",
        "causal",
        "judge_id",
        "lens",
        "mode",
        "candidate_digest",
        "anonymized_candidate",
        "criteria",
        "rubric_ref",
        "contract_excerpt",
        "evidence_index",
        "forbidden_context",
        "return_to",
        "issued_at"
      ],
      "properties": {
        "artifact_type": { "const": "JUDGE_ASSIGNMENT" },
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "judge_id": { "$ref": "#/$defs/judgeId" },
        "lens": { "$ref": "#/$defs/lens" },
        "mode": { "enum": [ "VALIDACAO", "VERIFICACAO" ] },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "anonymized_candidate": { "$ref": "#/$defs/artifactRef" },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/assignmentCriterion" },
          "minItems": 1,
          "uniqueItems": true
        },
        "rubric_ref": { "const": "rubrica-corte-v1" },
        "contract_excerpt": { "$ref": "#/$defs/contractExcerpt" },
        "evidence_index": { "$ref": "#/$defs/optionalRefs" },
        "forbidden_context": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "minItems": 4,
          "uniqueItems": true,
          "contains": { "type": "string", "pattern": "autoria" },
          "minContains": 1
        },
        "return_to": { "const": "departamento-juizes" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "judge_id": { "const": "agente-julgar-fidelidade-e-contrato" } },
            "required": [ "judge_id" ]
          },
          "then": {
            "properties": { "lens": { "const": "fidelidade-e-contrato" } }
          }
        },
        {
          "if": {
            "properties": { "judge_id": { "const": "agente-julgar-robustez-e-evidencia" } },
            "required": [ "judge_id" ]
          },
          "then": {
            "properties": { "lens": { "const": "robustez-e-evidencia" } }
          }
        },
        {
          "if": {
            "properties": { "judge_id": { "const": "agente-julgar-experiencia-e-risco" } },
            "required": [ "judge_id" ]
          },
          "then": {
            "properties": { "lens": { "const": "experiencia-e-risco" } }
          }
        }
      ]
    },
    "opinionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "score",
        "banda",
        "razao",
        "evidence_ref",
        "artifact_ref"
      ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "score": { "$ref": "#/$defs/score" },
        "banda": { "$ref": "#/$defs/banda" },
        "razao": { "type": "string", "minLength": 10 },
        "evidence_ref": { "$ref": "#/$defs/identifier" },
        "artifact_ref": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "criticalFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "tipo",
        "descricao",
        "evidence_ref",
        "artifact_ref"
      ],
      "properties": {
        "criterion_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "const": "n/a" }
          ]
        },
        "tipo": {
          "enum": [
            "RI",
            "RO",
            "seguranca",
            "evidencia-fabricada",
            "DONE-nao-provado"
          ]
        },
        "descricao": { "type": "string", "minLength": 10 },
        "evidence_ref": { "$ref": "#/$defs/identifier" },
        "artifact_ref": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "judgeOpinion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "assignment_id",
        "judge_id",
        "lens",
        "candidate_digest",
        "contract_digest",
        "scores",
        "critical_findings",
        "required_changes",
        "confidence",
        "status",
        "return_to",
        "issued_at"
      ],
      "properties": {
        "artifact_type": { "const": "JUDGE_OPINION" },
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "judge_id": { "$ref": "#/$defs/judgeId" },
        "lens": { "$ref": "#/$defs/lens" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "scores": {
          "type": "array",
          "items": { "$ref": "#/$defs/opinionScore" },
          "uniqueItems": true
        },
        "critical_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/criticalFinding" },
          "uniqueItems": true
        },
        "required_changes": { "$ref": "#/$defs/optionalStrings" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "abstencao": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "motivo" ],
          "properties": {
            "motivo": { "type": "string", "minLength": 10 }
          }
        },
        "status": { "enum": [ "COMPLETED", "BLOCKED" ] },
        "return_to": { "const": "departamento-juizes" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "COMPLETED" } },
            "required": [ "status" ]
          },
          "then": {
            "properties": {
              "scores": { "minItems": 1 },
              "confidence": {
                "enum": [ "alta", "media", "baixa" ]
              }
            }
          },
          "else": {
            "required": [ "abstencao" ],
            "properties": {
              "scores": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "judgeCapabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "capability",
        "judge_id",
        "criterion_ids",
        "expected_contract",
        "discovery_evidence",
        "impact",
        "status",
        "owner"
      ],
      "properties": {
        "artifact_type": { "const": "JUDGE_CAPABILITY_GAP" },
        "capability": { "type": "string", "minLength": 10 },
        "judge_id": {
          "oneOf": [
            { "$ref": "#/$defs/judgeId" },
            { "const": "n/a" }
          ]
        },
        "criterion_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "expected_contract": { "type": "string", "minLength": 10 },
        "discovery_evidence": { "type": "string", "minLength": 10 },
        "impact": { "type": "string", "minLength": 10 },
        "status": { "const": "OPEN" },
        "owner": { "const": "diretor-de-lentes" }
      }
    },
    "assignmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "assignment_id", "judge_id", "lens", "issued_at", "destination" ],
      "properties": {
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "judge_id": { "$ref": "#/$defs/judgeId" },
        "lens": { "$ref": "#/$defs/lens" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "destination": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "panelItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge_id",
        "lens",
        "status",
        "confidence",
        "substrate",
        "tier"
      ],
      "properties": {
        "judge_id": { "$ref": "#/$defs/judgeId" },
        "lens": { "$ref": "#/$defs/lens" },
        "status": { "$ref": "#/$defs/judgeStatus" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "substrate": { "type": "string", "minLength": 3 },
        "tier": { "type": "string", "minLength": 3 }
      }
    },
    "scorecardLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "judge_id",
        "lens",
        "role",
        "score",
        "razao",
        "evidence_ref",
        "artifact_ref"
      ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "judge_id": { "$ref": "#/$defs/judgeId" },
        "lens": { "$ref": "#/$defs/lens" },
        "role": { "enum": [ "owner", "secondary" ] },
        "score": { "$ref": "#/$defs/score" },
        "razao": { "type": "string", "minLength": 10 },
        "evidence_ref": { "$ref": "#/$defs/identifier" },
        "artifact_ref": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "panelRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "panel_record_id",
        "causal",
        "judgment_request_ref",
        "mode",
        "criteria_matrix",
        "assignments",
        "panel",
        "scorecard",
        "minimum_score",
        "verdict",
        "critical_fail",
        "blocking_pending_refs",
        "criticisms",
        "required_changes",
        "capability_gaps",
        "evidence_refs",
        "rubric_ref",
        "pending",
        "return_to",
        "recorded_at"
      ],
      "properties": {
        "artifact_type": { "const": "PANEL_RECORD" },
        "panel_record_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "judgment_request_ref": { "$ref": "#/$defs/identifier" },
        "mode": { "enum": [ "VALIDACAO", "VERIFICACAO" ] },
        "criteria_matrix": { "$ref": "#/$defs/criteriaMatrix" },
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assignmentRecord" },
          "uniqueItems": true
        },
        "panel": {
          "type": "array",
          "items": { "$ref": "#/$defs/panelItem" },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "scorecard": {
          "type": "array",
          "items": { "$ref": "#/$defs/scorecardLine" },
          "uniqueItems": true
        },
        "minimum_score": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 10 },
            { "const": "n/a" }
          ]
        },
        "verdict": { "enum": [ "VALIDATED", "REPROVED" ] },
        "critical_fail": { "type": "boolean" },
        "blocking_pending_refs": { "$ref": "#/$defs/optionalRefs" },
        "criticisms": { "$ref": "#/$defs/optionalStrings" },
        "required_changes": { "$ref": "#/$defs/optionalStrings" },
        "capability_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/judgeCapabilityGap" }
        },
        "evidence_refs": { "$ref": "#/$defs/requiredRefs" },
        "rubric_ref": { "const": "rubrica-corte-v1" },
        "pending": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "type": "string", "pattern": "R6" },
          "minContains": 1
        },
        "return_to": { "const": "diretor-de-lentes" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "VALIDATED" } },
            "required": [ "verdict" ]
          },
          "then": {
            "properties": {
              "minimum_score": { "type": "number", "minimum": 9.5 },
              "critical_fail": { "const": false },
              "blocking_pending_refs": { "maxItems": 0 },
              "capability_gaps": { "maxItems": 0 },
              "criteria_matrix": {
                "properties": { "uncovered": { "maxItems": 0 } }
              },
              "scorecard": { "minItems": 1 },
              "assignments": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "criticisms": { "minItems": 1 },
              "required_changes": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "panelHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "panel_handoff_id",
        "causal",
        "judgment_request_ref",
        "resumo",
        "rubric_ref",
        "status",
        "decision_mode",
        "leadership_reason",
        "winner",
        "champion_kept",
        "panel",
        "score_matrix",
        "divergences",
        "enxertos",
        "evidence_refs",
        "label_map_ref",
        "capability_gaps",
        "valid_opinions",
        "pending",
        "recommended_next_step",
        "return_to",
        "issued_at"
      ],
      "properties": {
        "artifact_type": { "const": "PANEL_HANDOFF" },
        "panel_handoff_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "judgment_request_ref": { "$ref": "#/$defs/identifier" },
        "resumo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recomendacao",
            "razao_mais_forte",
            "divergencia",
            "enxertos"
          ],
          "properties": {
            "recomendacao": { "type": "string", "minLength": 10 },
            "razao_mais_forte": { "type": "string", "minLength": 10 },
            "divergencia": { "type": "string", "minLength": 3 },
            "enxertos": { "type": "string", "minLength": 3 }
          }
        },
        "rubric_ref": { "const": "rubrica-corte-v1" },
        "status": { "enum": [ "COMPLETED", "PARTIAL", "BLOCKED" ] },
        "decision_mode": {
          "enum": [
            "CONSENSO_UNANIME",
            "CONSENSO_PARCIAL",
            "CONSENSO_MAIORIA",
            "DECISAO_DE_LIDERANCA"
          ]
        },
        "leadership_reason": {
          "enum": [ "SEM_CONSENSO", "SEM_RETORNO", "QUORUM_DEGRADADO", "n/a" ]
        },
        "winner": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "champion_kept": {
          "oneOf": [
            { "type": "boolean" },
            { "const": "n/a" }
          ]
        },
        "panel": {
          "type": "array",
          "items": { "$ref": "#/$defs/panelItem" },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "score_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "judge_id",
              "label",
              "candidate_ref",
              "criterion_id",
              "score"
            ],
            "properties": {
              "judge_id": { "$ref": "#/$defs/judgeId" },
              "label": { "type": "string", "pattern": "^[A-Z]$" },
              "candidate_ref": { "$ref": "#/$defs/identifier" },
              "criterion_id": { "$ref": "#/$defs/identifier" },
              "score": { "$ref": "#/$defs/score" }
            }
          },
          "uniqueItems": true
        },
        "divergences": { "$ref": "#/$defs/optionalStrings" },
        "enxertos": { "$ref": "#/$defs/optionalStrings" },
        "evidence_refs": { "$ref": "#/$defs/optionalRefs" },
        "label_map_ref": { "$ref": "#/$defs/artifactRef" },
        "capability_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/judgeCapabilityGap" }
        },
        "valid_opinions": { "type": "integer", "minimum": 0, "maximum": 3 },
        "pending": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "type": "string", "pattern": "R6" },
          "minContains": 1
        },
        "recommended_next_step": { "type": "string", "minLength": 10 },
        "return_to": { "const": "diretor-de-lentes" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_mode": {
                "enum": [
                  "CONSENSO_UNANIME",
                  "CONSENSO_PARCIAL",
                  "CONSENSO_MAIORIA"
                ]
              }
            },
            "required": [ "decision_mode" ]
          },
          "then": {
            "properties": { "leadership_reason": { "const": "n/a" } }
          },
          "else": {
            "properties": {
              "leadership_reason": {
                "enum": [ "SEM_CONSENSO", "SEM_RETORNO", "QUORUM_DEGRADADO" ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "COMPLETED" } },
            "required": [ "status" ]
          },
          "then": {
            "properties": {
              "capability_gaps": { "maxItems": 0 },
              "valid_opinions": { "minimum": 2 }
            }
          }
        }
      ]
    },
    "independentVerificationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "verification_id",
        "causal",
        "limitation_report_ref",
        "candidate_digest",
        "score_snapshot_digest",
        "checks",
        "verdict",
        "independence_confirmed",
        "all_below_cutoff_criteria_covered",
        "evidence_refs",
        "dissent_refs",
        "return_to",
        "issued_at"
      ],
      "properties": {
        "artifact_type": { "const": "INDEPENDENT_VERIFICATION" },
        "verification_id": { "$ref": "#/$defs/identifier" },
        "causal": { "$ref": "#/$defs/causalHeader" },
        "limitation_report_ref": { "$ref": "#/$defs/identifier" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "score_snapshot_digest": { "$ref": "#/$defs/digest" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_verified",
            "all_below_cutoff_criteria_covered",
            "attempts_executed",
            "alternatives_discarded",
            "best_attainable_consistent",
            "nonwaivable_gates_intact"
          ],
          "properties": {
            "correlation_verified": { "type": "boolean" },
            "all_below_cutoff_criteria_covered": { "type": "boolean" },
            "attempts_executed": { "type": "boolean" },
            "alternatives_discarded": { "type": "boolean" },
            "best_attainable_consistent": { "type": "boolean" },
            "nonwaivable_gates_intact": { "type": "boolean" }
          }
        },
        "verdict": {
          "enum": [ "VERIFIED_IMPOSSIBILITY", "NOT_VERIFIED" ]
        },
        "independence_confirmed": { "type": "boolean" },
        "all_below_cutoff_criteria_covered": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/requiredRefs" },
        "dissent_refs": { "$ref": "#/$defs/optionalRefs" },
        "return_to": { "const": "diretor-de-lentes" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "VERIFIED_IMPOSSIBILITY" } },
            "required": [ "verdict" ]
          },
          "then": {
            "properties": {
              "independence_confirmed": { "const": true },
              "all_below_cutoff_criteria_covered": { "const": true },
              "checks": {
                "properties": {
                  "correlation_verified": { "const": true },
                  "all_below_cutoff_criteria_covered": { "const": true },
                  "attempts_executed": { "const": true },
                  "alternatives_discarded": { "const": true },
                  "best_attainable_consistent": { "const": true },
                  "nonwaivable_gates_intact": { "const": true }
                }
              }
            }
          }
        }
      ]
    }
  }
}
